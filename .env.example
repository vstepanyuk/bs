# Copy to .env and adjust as needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learner_progress
BIND_ADDR=0.0.0.0:8080
# Stand-in for a secret injected from the secret store in production.
CONTENT_SERVICE_API_KEY=dev-content-key-not-real
# Insert demo learners on startup only when built with --features dev-seed.
SEED_DEV_DATA=1
# Logging
RUST_LOG=learner_progress_service=debug
